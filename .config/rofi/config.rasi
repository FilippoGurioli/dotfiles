configuration {
    modi: "drun,run,filebrowser,window";
    font: "Sans 11";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "foot";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "APPS";
}

@theme "tokyonight"
