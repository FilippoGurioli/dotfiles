* {
    bg0:     #1a1b26;
    bg1:     #24283b;
    bg2:     #292e42;
    fg0:     #c0caf5;
    fg1:     #a9b1d6;
    
    accent:  #9ece6a;
    cyan:    #7dcfff;
    blue:    #7aa2f7;
    purple:  #bb9af7;
    red:     #f7768e;

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    background-color:   @bg0;
    border:             2px;
    border-color:       @accent;
    border-radius:      12px;
    width:              600px;
    padding:            16px;
}

inputbar {
    spacing:            12px;
    padding:            8px 12px;
    background-color:   @bg1;
    border-radius:      8px;
    children:           [ prompt, entry ];
}

prompt {
    text-color:         @accent;
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @fg1;
    text-color:         @fg0;
}

listview {
    lines:              8;
    columns:            1;
    fixed-height:       false;
    spacing:            4px;
    margin:             12px 0 0 0;
}

element {
    padding:            8px 12px;
    border-radius:      6px;
    text-color:         @fg1;
}

element selected {
    background-color:   @bg2;
    text-color:         @accent;
}

element-icon {
    size:               24px;
    margin:             0 12px 0 0;
}

element-text {
    text-color:         inherit;
    vertical-align:     0.5;
}
